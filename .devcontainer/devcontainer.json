{
  "name": "Scout Camera — Flutter Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/root/.claude,type=volume"
  ],
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "dart-code.flutter",
        "dart-code.dart-code",
        "drblury.protobuf-vsc",
        "dbcode.dbcode",
        "hanwang.android-adb-wlan",
        "diemasmichiels.emulate"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "Dart-Code.dart-code",
        "[dart]": {
          "editor.formatOnSave": true,
          "editor.rulers": [
            80
          ]
        },
        "dart.flutterSdkPath": "/sdks/flutter",
        "dart.sdkPath": "/sdks/flutter/bin/cache/dart-sdk"
      }
    }
  },
  "postCreateCommand": ".devcontainer/script/post-create.sh",
  "postStartCommand": ".devcontainer/script/post-start.sh",
  "remoteEnv": {
    "ADB_SERVER_SOCKET": "tcp:host.docker.internal:5037"
  }
}
