{
  "name": "Scout Camera — Flutter Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "options": [
      "--tag",
      "flutter4android"
    ]
  },
  "containerEnv": {
    "SHELL": "/bin/bash"
  },
  "runArgs": [
    "--platform",
    "linux/amd64",
    "--name",
    "${localWorkspaceFolderBasename}_flutter4android_devcontainer",
    "--add-host=host.docker.internal:host-gateway"
  ],
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
    //"ghcr.io/devcontainers-extra/features/go-task:1": {}
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=${localWorkspaceFolder}/.devcontainer/.bashrc,target=/home/vscode/.bashrc.1,readonly,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "dart-code.flutter",
        "dart-code.dart-code",
        "task.vscode-task",
        "redhat.vscode-yaml",
        "drblury.protobuf-vsc",
        "dbcode.dbcode",
        "hanwang.android-adb-wlan",
        "diemasmichiels.emulate"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "Dart-Code.dart-code",
        "[dart]": {
          "editor.formatOnSave": true,
          "editor.rulers": [
            80
          ]
        },
        "dart.flutterSdkPath": "/home/vscode/flutter",
        "dart.sdkPath": "/home/vscode/flutter/bin/cache/dart-sdk"
      }
    }
  },
  "initializeCommand": ".devcontainer/script/initialize-command.sh",
  "onCreateCommand": ".devcontainer/script/on-create.sh",
  "postCreateCommand": ".devcontainer/script/post-create.sh",
  "postStartCommand": ".devcontainer/script/post-start.sh",
  "postAttachCommand": ".devcontainer/script/post-attach.sh",
  "waitFor": "postStartCommand",
  "remoteEnv": {
    "CHOKIDAR_USEPOLLING": "true",
    "ADB_SERVER_SOCKET": "tcp:host.docker.internal:5037",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  }
}
