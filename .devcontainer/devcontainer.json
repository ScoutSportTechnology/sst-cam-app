{
  "name": "SST Cam — Flutter Dev",
  "dockerComposeFile": [
    "docker-compose.yml"
  ],
  "service": "app",
  "runServices": [
    "mock-camera-wifi"
  ],
  "workspaceFolder": "/workspaces/sst-cam-app",
  "containerEnv": {
    "SHELL": "/bin/bash"
  },
  "features": {
    // Claude Code is baked into the Dockerfile image — no feature needed here.
    //"ghcr.io/devcontainers-extra/features/go-task:1": {}
    // `just` task runner — backs the repo's justfile (build/test recipes).
    "ghcr.io/guiyomh/features/just:0": {}
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/.bashrc,target=/home/vscode/.bashrc.1,readonly,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dart-code.flutter",
        "dart-code.dart-code",
        //"task.vscode-task",
        "redhat.vscode-yaml",
        "drblury.protobuf-vsc",
        "dbcode.dbcode",
        "hanwang.android-adb-wlan",
        "diemasmichiels.emulate"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "Dart-Code.dart-code",
        "[dart]": {
          "editor.formatOnSave": true,
          "editor.rulers": [
            80
          ]
        },
        "dart.flutterSdkPath": "/home/vscode/flutter",
        "dart.sdkPath": "/home/vscode/flutter/bin/cache/dart-sdk"
      }
    }
  },
  "initializeCommand": ".devcontainer/script/initialize-command.sh",
  "onCreateCommand": ".devcontainer/script/on-create.sh",
  "postCreateCommand": ".devcontainer/script/post-create.sh",
  "postStartCommand": ".devcontainer/script/post-start.sh",
  "postAttachCommand": ".devcontainer/script/post-attach.sh",
  "waitFor": "postStartCommand",
  "remoteEnv": {
    "CHOKIDAR_USEPOLLING": "true",
    "ADB_SERVER_SOCKET": "tcp:host.docker.internal:5037",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  }
}