# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# Protoc binaries — devcontainer already provides protoc
protoc-*.zip

# Claude Code local settings — machine-specific, not shared
.claude/settings.local.json

# Generated protobuf Dart bindings — run `just gen-proto` to regenerate
lib/models/proto/

# Android release signing — never commit the keystore or its passwords.
# key.properties.example is the committed, placeholder-only template.
android/key.properties
*.jks
*.keystore

# Lock files
pubspec.lock.claude/worktrees/

# Local dev tooling (adb pairing keys — never commit)
.devtools/
